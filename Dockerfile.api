FROM python:3.11-slim

LABEL maintainer="XX Auto Jobs Applier"
LABEL description="Minimal API для мониторинга Multi-Tenant режима"

WORKDIR /app

# Install dependencies
COPY requirements-multitenant.txt .
RUN pip install --no-cache-dir -r requirements-multitenant.txt

# Copy only necessary files for API
COPY api/ ./api/
COPY src/queue/ ./src/queue/
COPY src/__init__.py ./src/__init__.py

# Create non-root user
RUN groupadd -r apiuser && useradd -r -g apiuser apiuser
RUN chown -R apiuser:apiuser /app
USER apiuser

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s \
    CMD python -c "import requests; requests.get('http://localhost:8000/health')"

# Expose port
EXPOSE 8000

# Run API
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000"]
